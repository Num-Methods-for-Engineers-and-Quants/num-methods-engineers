# =============================================================================
# Python Engineering & Scientific Computing
# =============================================================================
# Supported environments:
#   - Python 3.12+
#   - uv
#   - Spyder
#   - JetBrains / PyCharm
#   - Visual Studio Code
#   - Linux / Windows / macOS
#
# Repository principles:
#   - Track source code, tests, and technical documentation.
#   - Track dependency definitions and lockfiles.
#   - Track reproducible engineering input datasets.
#   - Exclude local environments, caches, and generated artifacts.
#   - Never commit credentials or confidential information.
# =============================================================================


# =============================================================================
# 01. Python Bytecode and Interpreter Artifacts
# =============================================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd


# =============================================================================
# 02. Virtual Environments
# =============================================================================

.venv/
venv/
env/
ENV/
.conda/
.venv.bak/
venv.bak/
env.bak/
__pypackages__/


# =============================================================================
# 03. Package Management
# =============================================================================

# uv
.uv-cache/

# pip
.pip-cache/
pip-log.txt
pip-delete-this-directory.txt

# Local Python interpreter overrides
.python-version.local

# Dependency definitions and lockfiles remain tracked.
!pyproject.toml
!uv.lock
!requirements*.txt
!.python-version


# =============================================================================
