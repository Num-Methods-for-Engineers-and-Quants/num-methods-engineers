# =============================================================================

/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/parts/
/sdist/
/wheels/
/pip-wheel-metadata/

.eggs/
*.egg-info/
*.egg
*.whl
.installed.cfg
MANIFEST


