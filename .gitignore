# =============================================================================
# 11. Documentation Build Artifacts
# =============================================================================

/docs/_build/
/docs/build/
/docs/.doctrees/
/site/

# Markdown, source documentation, engineering references,
# and verification documentation remain tracked.


# =============================================================================
# 12. Scientific Computing and Numerical Modeling
# =============================================================================

# Generated numerical caches
*.nbi
*.nbc

# Generated profiling and diagnostic artifacts
*.prof
*.lprof
*.pstats
*.pyprof

# Generated simulation artifacts
/simulation_cache/
/simulation_runs/
/model_runs/
/outputs/generated/
/results/generated/
/artifacts/generated/

# Scientific datasets are NOT globally ignored.
# Examples of intentionally tracked formats:
#
#   *.csv
#   *.json
#   *.yaml
#   *.xlsx
#   *.parquet
#   *.npy
#   *.npz
#   *.inp
#   *.rpt
#
# Engineering inputs and benchmark results may be required
# for reproducibility and independent verification.


# =============================================================================
# 13. Local and Confidential Data
# =============================================================================

/data/raw/private/
/data/confidential/
/data/local/
/data/generated/

/inputs/private/
/inputs/local/

/outputs/private/
/results/private/

# Generated computational outputs at any directory depth
outputs/


/scratch/
/sandbox/
/tmp/
/temp/

# Retain directory placeholders where applicable.
!/data/raw/private/.gitkeep
!/data/confidential/.gitkeep
!/data/local/.gitkeep
!/data/generated/.gitkeep


# =============================================================================
# 14. Machine Learning Artifacts
# =============================================================================

/checkpoints/
/mlruns/
/wandb/
/lightning_logs/
/tensorboard_logs/
/models/generated/
/models/checkpoints/

# Trained models and serialized scientific objects should
# be evaluated individually before being committed.
#
# Do not globally exclude model files if they are required
# for verification, deployment, or reproducibility.


